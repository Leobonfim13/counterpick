# Copie este arquivo com o nome .env e cole a sua chave depois do sinal de igual.
# Pegue a chave em https://developer.riotgames.com (ela começa com RGAPI-).
# NUNCA mande este arquivo nem a chave para ninguém.
RIOT_API_KEY=

# Modo amigos: 1 = seus amigos acessam pela rede privada do Tailscale (veja o LEIA-ME). 0 = só este PC.
COUNTERPICK_AMIGOS=0

# Seu Riot ID (nome#TAG). Fica só neste PC; o perfil já abre com ele.
COUNTERPICK_RIOT_ID=
